#!/usr/bin/env python3
"""Deterministic stand-in for `claude -p --output-format stream-json`.

Used by scripts/acp-tck.sh so ACP conformance runs need no vendor account.
A prompt containing SLOW streams for about 20 seconds, which keeps a turn
in flight long enough for the cancellation tests.
"""
import json
import sys
import time

import subprocess


def connect_mcp_servers(config_text):
    """Does what the real CLI does with --mcp-config: launch each stdio
    server and perform the MCP initialize handshake."""
    for name, server in json.loads(config_text).get("mcpServers", {}).items():
        try:
            process = subprocess.Popen(
                [server["command"], *server.get("args", [])],
                env={**__import__("os").environ, **server.get("env", {})},
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
            )
            request = {
                "jsonrpc": "2.0", "id": 1, "method": "initialize",
                "params": {"protocolVersion": "2025-06-18", "capabilities": {},
                           "clientInfo": {"name": "fake-claude-code", "version": "0"}},
            }
            process.stdin.write(json.dumps(request) + "\n")
            process.stdin.flush()
            process.stdout.readline()
            process.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
            process.stdin.flush()
            process.stdin.close()
            process.wait(timeout=5)
        except Exception as error:  # the fake keeps going, like a vendor would
            sys.stderr.write(f"mcp server {name}: {error}\n")


if "--mcp-config" in sys.argv:
    connect_mcp_servers(sys.argv[sys.argv.index("--mcp-config") + 1])

prompt = sys.stdin.read()
slow = "SLOW" in prompt
session_id = "fake-session-1"


def emit(event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


emit({"type": "system", "subtype": "init", "session_id": session_id})
words = ["Hello", " from", " the", " fake", " vendor", "."]
text = ""
for _ in range(70 if slow else 1):
    for word in words:
        text += word
        emit({
            "type": "stream_event",
            "session_id": session_id,
            "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": word}},
        })
        time.sleep(0.05 if slow else 0.005)
emit({
    "type": "result",
    "subtype": "success",
    "result": text,
    "session_id": session_id,
    "usage": {"input_tokens": 3, "output_tokens": 6},
})
