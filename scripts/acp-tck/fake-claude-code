#!/usr/bin/env python3
"""Deterministic stand-in for `claude -p --output-format stream-json`.

Used by scripts/acp-tck.sh so ACP conformance runs need no vendor account.
A prompt containing SLOW streams for about 20 seconds, which keeps a turn
in flight long enough for the cancellation tests. A prompt containing TOOLS
also reports a todo list and tool calls the way the real CLI does; together
with SLOW, one tool call is still running while the turn is in flight.
"""
import json
import sys
import time

import subprocess


def connect_mcp_servers(config_text):
    """Does what the real CLI does with --mcp-config: launch each stdio
    server and perform the MCP initialize handshake."""
    for name, server in json.loads(config_text).get("mcpServers", {}).items():
        try:
            process = subprocess.Popen(
                [server["command"], *server.get("args", [])],
                env={**__import__("os").environ, **server.get("env", {})},
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
            )
            request = {
                "jsonrpc": "2.0", "id": 1, "method": "initialize",
                "params": {"protocolVersion": "2025-06-18", "capabilities": {},
                           "clientInfo": {"name": "fake-claude-code", "version": "0"}},
            }
            process.stdin.write(json.dumps(request) + "\n")
            process.stdin.flush()
            process.stdout.readline()
            process.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
            process.stdin.flush()
            process.stdin.close()
            process.wait(timeout=5)
        except Exception as error:  # the fake keeps going, like a vendor would
            sys.stderr.write(f"mcp server {name}: {error}\n")


if "--mcp-config" in sys.argv:
    connect_mcp_servers(sys.argv[sys.argv.index("--mcp-config") + 1])

prompt = sys.stdin.read()
slow = "SLOW" in prompt
session_id = "fake-session-1"


def emit(event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


emit({"type": "system", "subtype": "init", "session_id": session_id})


def stream_event(event):
    emit({"type": "stream_event", "session_id": session_id, "parent_tool_use_id": None, "event": event})


def tool_use(tool_id, name, tool_input, result=None, is_error=False):
    """Announces a tool call, completes its input, and (with `result`) ends it."""
    block = {"type": "tool_use", "id": tool_id, "name": name}
    stream_event({"type": "content_block_start", "index": 0, "content_block": {**block, "input": {}}})
    emit({
        "type": "assistant", "session_id": session_id, "parent_tool_use_id": None,
        "message": {"model": "fake", "role": "assistant", "content": [{**block, "input": tool_input}]},
    })
    if result is not None:
        emit({
            "type": "user", "session_id": session_id, "parent_tool_use_id": None,
            "message": {"role": "user", "content": [
                {"type": "tool_result", "tool_use_id": tool_id, "content": result, "is_error": is_error},
            ]},
            "tool_use_result": {"stdout": result, "stderr": ""},
        })


tools = "TOOLS" in prompt
if tools:
    usage = {"input_tokens": 3, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "output_tokens": 1}
    stream_event({"type": "message_start", "message": {"model": "fake", "usage": usage}})
    tool_use("toolu_todo", "TodoWrite", {"todos": [
        {"content": "Read the note", "status": "in_progress", "activeForm": "Reading the note"},
        {"content": "Answer", "status": "pending", "activeForm": "Answering"},
    ]}, "Todos have been modified successfully.")
    tool_use("toolu_read", "Read", {"file_path": "/tmp/note.txt"}, "1\thello")
    tool_use("toolu_fail", "Bash", {"command": "false", "description": "Fail"}, "Exit code 1", is_error=True)
    tool_use("toolu_open", "Bash", {"command": "sleep 30"}, None if slow else "")
    stream_event({"type": "message_delta", "delta": {"stop_reason": "tool_use"}, "usage": {**usage, "output_tokens": 6}})
words = ["Hello", " from", " the", " fake", " vendor", "."]
text = ""
for _ in range(70 if slow else 1):
    for word in words:
        text += word
        emit({
            "type": "stream_event",
            "session_id": session_id,
            "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": word}},
        })
        time.sleep(0.05 if slow else 0.005)
emit({
    "type": "result",
    "subtype": "success",
    "result": text,
    "session_id": session_id,
    "usage": {"input_tokens": 3, "output_tokens": 6},
    **({"total_cost_usd": 0.0125, "modelUsage": {"fake": {"contextWindow": 200000}}} if tools else {}),
})
